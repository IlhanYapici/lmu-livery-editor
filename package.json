{
  "name": "lmu-livery-editor",
  "version": "0.4.0",
  "private": true,
  "description": "Livery editor for Le Mans Ultimate",
  "license": "MIT",
  "author": "IlhanYapici",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win dir -c.win.signAndEditExecutable=false",
    "dist:linux": "electron-vite build && electron-builder --linux dir",
    "deploy:win": "scripts/deploy-win.sh",
    "dev:game": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-game.ts",
    "audit:build": "rolldown scripts/audit-templates.ts --platform node --format cjs --file out/audit/audit-templates.cjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks",
    "e2e": "electron-vite build && playwright test",
    "dist:installer": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "ag-psd": "34.1.0",
    "dompurify": "3.4.17",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint-plugin-i18next": "6.1.5",
    "i18next": "26.7.2",
    "konva": "10.9.1",
    "marked": "18.1.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-konva": "19.3.2",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11.10"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
