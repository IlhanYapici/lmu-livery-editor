{
  "name": "lmu-livery-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Livery editor for Le Mans Ultimate",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win",
    "deploy:win": "scripts/deploy-win.sh",
    "audit:build": "rolldown scripts/audit-templates.ts --platform node --format cjs --file out/audit/audit-templates.cjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ag-psd": "^34.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint-plugin-i18next": "^6.1.5",
    "i18next": "^26.6.0",
    "konva": "^10.9.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.10",
    "react-konva": "^19.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
