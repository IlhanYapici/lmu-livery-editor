{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 140,
  "trailingComma": "none",
  "arrowParens": "always",
  "ignorePatterns": ["out/**", "dist/**", "node_modules/**", "package-lock.json", "*.psd", "*.tga", "CHANGELOG.md"]
}
