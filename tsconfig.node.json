{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["electron.vite.config.mts", "vitest.config.mts", "scripts/**/*.ts", "tests/**/*.ts", "src/**/*", "playwright.config.ts"],
  "exclude": ["src/renderer/**"]
}
